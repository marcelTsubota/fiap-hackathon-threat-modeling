# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment (all variants)
.venv/
.venv-1/
.venv-2/
.venv*/
venv/
ENV/

# Environment files
.env
!.env.example

# Byte-compiled / optimized / DLL files
*.pyc
*.pyo
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Logs and databases
*.log
*.sqlite3

# YOLO training runs (large binary artifacts; best.pt is kept in models/)
runs/

# Root-level model weights (duplicate of models/)
yolov8n.pt

# IDE/editor directories
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Data — keep config/kb, ignore generated images/labels
data/images/
data/labels/
data/raw_icons/
!data/data.yaml
!data/kb.json

# Models — ignore weights (large binary files)
models/*.pt

# Outputs (generated PDFs)
outputs/

# Training runs
runs/

# Static and templates if generated
staticfiles/

# Python unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.pytest_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
